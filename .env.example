# ─── n8n local webhook ────────────────────────────────────────
# URL of the n8n webhook that returns Filen credentials.
# Default: http://localhost:5678/webhook/filen (local Docker n8n)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/filen

# ─── Filen (env-only mode — bypasses n8n entirely) ────────────
# FILEN_EMAIL=
# FILEN_PASSWORD=
# FILEN_FOLDER_UUID=
# FILEN_FOLDER_PATH=/EO-DB
# FILEN_API_KEY=
# FILEN_MASTER_KEYS=

# ─── Matrix homeserver ────────────────────────────────────────
# EO_MATRIX_HOMESERVER=https://matrix.example.com
# EO_WEBHOOK_SECRET=
# EO_WEBHOOK_USER=@bot:matrix.example.com

# ─── Server ───────────────────────────────────────────────────
# EO_PORT=3000
# EO_DATA_DIR=./data
# EO_LOG_LEVEL=info
