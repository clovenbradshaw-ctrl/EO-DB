{
  "_comment": [
    "Example: Import that triggers REC → INS2 → second REC → INS3",
    "",
    "This import builds two dependency cycles and then bridges them.",
    "The system detects each cycle, runs fixed-point iteration (REC),",
    "and produces derived entities at increasing INS levels.",
    "",
    "Timeline of what happens:",
    "",
    "Phase 1 — First cycle (budget ↔ headcount):",
    "  Events 1-2: INS two formula targets (budget, headcount)",
    "  Events 3-4: CON creates mutual dependency (A→B, B→A)",
    "  Event 5:    DEF registers formula on budget (no cycle yet)",
    "  Event 6:    DEF registers formula on headcount — COMPLETES CYCLE",
    "  → System detects A↔B cycle",
    "  → System emits REC (seq 7) with fixed-point iteration result",
    "  → System emits INS level 2 (seq 8): derived entity system.rec.XXXX",
    "",
    "Phase 2 — Second cycle (revenue ↔ cost):",
    "  Events 9-14: Same pattern, builds revenue↔cost cycle",
    "  → System emits REC (seq 15)",
    "  → System emits INS level 2 (seq 16): second derived entity",
    "",
    "Phase 3 — Meta-cycle (bridge the two derived entities):",
    "  Events 17-18: CON connects budget→(derived entity 2), revenue→(derived entity 1)",
    "  → If both derived entities now have EVA formulas with mutual deps,",
    "    the system detects a level-2 cycle and cascades upward.",
    "  → System emits REC at meta level",
    "  → System emits INS level 3: meta-derived entity"
  ],

  "phase_1_first_cycle": {
    "description": "Two formula targets with mutual dependency → REC + INS2",
    "events": [
      {
        "op": "INS",
        "target": "dept.finance.budget",
        "operand": { "amount": 500000, "currency": "USD", "fiscal_year": 2025 },
        "client_event_id": "cascade-001"
      },
      {
        "op": "INS",
        "target": "dept.finance.headcount",
        "operand": { "count": 25, "department": "finance" },
        "client_event_id": "cascade-002"
      },
      {
        "op": "CON",
        "target": "dept.finance.budget",
        "operand": { "added": ["dept.finance.headcount"], "edge_type": "depends_on" },
        "client_event_id": "cascade-003"
      },
      {
        "op": "CON",
        "target": "dept.finance.headcount",
        "operand": { "added": ["dept.finance.budget"], "edge_type": "depends_on" },
        "client_event_id": "cascade-004"
      },
      {
        "op": "DEF",
        "target": "dept.finance.budget",
        "operand": { "formula": "headcount * 20000" },
        "client_event_id": "cascade-005"
      },
      {
        "op": "DEF",
        "target": "dept.finance.headcount",
        "operand": { "formula": "budget / 22000" },
        "client_event_id": "cascade-006"
      }
    ]
  },

  "phase_2_second_cycle": {
    "description": "Another pair with mutual dependency → second REC + second INS2",
    "events": [
      {
        "op": "INS",
        "target": "dept.ops.revenue",
        "operand": { "amount": 1200000, "currency": "USD", "quarter": "Q3" },
        "client_event_id": "cascade-007"
      },
      {
        "op": "INS",
        "target": "dept.ops.cost",
        "operand": { "amount": 800000, "type": "operational" },
        "client_event_id": "cascade-008"
      },
      {
        "op": "CON",
        "target": "dept.ops.revenue",
        "operand": { "added": ["dept.ops.cost"], "edge_type": "depends_on" },
        "client_event_id": "cascade-009"
      },
      {
        "op": "CON",
        "target": "dept.ops.cost",
        "operand": { "added": ["dept.ops.revenue"], "edge_type": "depends_on" },
        "client_event_id": "cascade-010"
      },
      {
        "op": "DEF",
        "target": "dept.ops.revenue",
        "operand": { "formula": "cost * 1.5" },
        "client_event_id": "cascade-011"
      },
      {
        "op": "DEF",
        "target": "dept.ops.cost",
        "operand": { "formula": "revenue * 0.7" },
        "client_event_id": "cascade-012"
      }
    ]
  },

  "phase_3_bridge": {
    "description": "Connect the two cycles' constituents to create cross-cycle dependencies, triggering cascade to INS3",
    "_note": "The derived entity targets (system.rec.XXXXX) are deterministic hashes of the sorted constituents. After phase 1 and 2 run, the actual target names appear in the log. These CON events create cross-links between the original formula targets and the other cycle's members, causing the cascade mechanism to re-evaluate derived entities and potentially produce level 3.",
    "events": [
      {
        "op": "CON",
        "target": "dept.finance.budget",
        "operand": { "added": ["dept.ops.cost"], "edge_type": "cross_dept" },
        "client_event_id": "cascade-013"
      },
      {
        "op": "CON",
        "target": "dept.ops.revenue",
        "operand": { "added": ["dept.finance.headcount"], "edge_type": "cross_dept" },
        "client_event_id": "cascade-014"
      }
    ]
  },

  "_flat_events_for_import": [
    { "op": "INS", "target": "dept.finance.budget", "operand": { "amount": 500000, "currency": "USD", "fiscal_year": 2025 }, "client_event_id": "cascade-001" },
    { "op": "INS", "target": "dept.finance.headcount", "operand": { "count": 25, "department": "finance" }, "client_event_id": "cascade-002" },
    { "op": "CON", "target": "dept.finance.budget", "operand": { "added": ["dept.finance.headcount"], "edge_type": "depends_on" }, "client_event_id": "cascade-003" },
    { "op": "CON", "target": "dept.finance.headcount", "operand": { "added": ["dept.finance.budget"], "edge_type": "depends_on" }, "client_event_id": "cascade-004" },
    { "op": "DEF", "target": "dept.finance.budget", "operand": { "formula": "headcount * 20000" }, "client_event_id": "cascade-005" },
    { "op": "DEF", "target": "dept.finance.headcount", "operand": { "formula": "budget / 22000" }, "client_event_id": "cascade-006" },
    { "op": "INS", "target": "dept.ops.revenue", "operand": { "amount": 1200000, "currency": "USD", "quarter": "Q3" }, "client_event_id": "cascade-007" },
    { "op": "INS", "target": "dept.ops.cost", "operand": { "amount": 800000, "type": "operational" }, "client_event_id": "cascade-008" },
    { "op": "CON", "target": "dept.ops.revenue", "operand": { "added": ["dept.ops.cost"], "edge_type": "depends_on" }, "client_event_id": "cascade-009" },
    { "op": "CON", "target": "dept.ops.cost", "operand": { "added": ["dept.ops.revenue"], "edge_type": "depends_on" }, "client_event_id": "cascade-010" },
    { "op": "DEF", "target": "dept.ops.revenue", "operand": { "formula": "cost * 1.5" }, "client_event_id": "cascade-011" },
    { "op": "DEF", "target": "dept.ops.cost", "operand": { "formula": "revenue * 0.7" }, "client_event_id": "cascade-012" },
    { "op": "CON", "target": "dept.finance.budget", "operand": { "added": ["dept.ops.cost"], "edge_type": "cross_dept" }, "client_event_id": "cascade-013" },
    { "op": "CON", "target": "dept.ops.revenue", "operand": { "added": ["dept.finance.headcount"], "edge_type": "cross_dept" }, "client_event_id": "cascade-014" }
  ]
}
