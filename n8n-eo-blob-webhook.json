      "parameters": {
        "jsCode": "// Parse & validate. No fs, no crypto — pure JS only.\n\nfunction homeserverFromRoomId(roomId) {\n  const idx = roomId.indexOf(':');\n  if (idx < 0) return null;\n  const hs = roomId.slice(idx + 1).trim();\n  if (!/^[a-zA-Z0-9.\\-]+(:[0-9]+)?$/.test(hs)) return null;\n  return hs;\n}\n\nconst item = $input.first().json;\nlet req = item.body || {};\nif (typeof req === 'string') { try { req = JSON.parse(req); } catch { req = {}; } }\n\nconst { matrix_token, op, room_id, data_id, envelope } = req;\n\nif (!matrix_token) return [{ json: { __error: true, statusCode: 401, errorBody: { error: 'missing matrix_token' } } }];\nif (!['store','get'].includes(op)) return [{ json: { __error: true, statusCode: 400, errorBody: { error: `invalid op (got ${op})` } } }];\nif (!room_id || !room_id.startsWith('!')) return [{ json: { __error: true, statusCode: 400, errorBody: { error: 'room_id required (must start with !)' } } }];\n\nconst homeserver = homeserverFromRoomId(room_id);\nif (!homeserver) return [{ json: { __error: true, statusCode: 400, errorBody: { error: 'malformed room_id' } } }];\n\nif (!data_id || !/^[a-zA-Z0-9_:-]{1,128}$/.test(data_id)) {\n  return [{ json: { __error: true, statusCode: 400, errorBody: { error: 'data_id required, [a-zA-Z0-9_:-]{1,128}' } } }];\n}\n\nif (op === 'store') {\n  if (!envelope || !envelope.iv || !envelope.ct || !envelope.content_hash) {\n    return [{ json: { __error: true, statusCode: 400, errorBody: { error: 'store needs envelope with iv, ct, content_hash' } } }];\n  }\n}\n\nreturn [{ json: {\n  __error: false,\n  matrix_token, op, room_id, homeserver, data_id,\n  envelope: envelope || null,\n  file_path: `/mnt/eo-blobs/${data_id}.enc`,\n}}];"
      },
