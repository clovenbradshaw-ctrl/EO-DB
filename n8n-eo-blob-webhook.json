      "parameters": {
        "jsCode": "const resp = $input.first().json;\nif (resp.statusCode !== 200 || !resp.body?.user_id) {\n  return [{ json: { __error: true, statusCode: 401, errorBody: { error: 'invalid matrix_token' } } }];\n}\nconst prev = $('Parse').first().json;\nreturn [{ json: {\n  __error: false,\n  user_id: resp.body.user_id,\n  matrix_token: prev.matrix_token,\n  op: prev.op,\n  room_id: prev.room_id,\n  homeserver: prev.homeserver,\n  data_id: prev.data_id,\n  envelope: prev.envelope,\n  file_path: prev.file_path,\n}}];"
