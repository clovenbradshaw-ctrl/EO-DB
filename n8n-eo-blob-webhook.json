    {
      "parameters": {
        "jsCode": "// Emit 404 when the read-file node produced no binary (missing file, or\n// error with alwaysOutputData=true). Otherwise decode the envelope and\n// return it. Pulling data_id/room_id from Authorize1 lets us respond even\n// when $input is an empty/error passthrough.\nconst item = $input.first();\nconst prev = $('Authorize1').first().json;\n\nif (!item?.binary?.data?.data) {\n  return [{ json: { statusCode: 404, body: { error: 'blob not found', data_id: prev.data_id } } }];\n}\n\nlet envelope;\ntry {\n  const raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n  envelope = JSON.parse(raw);\n} catch (e) {\n  return [{ json: { statusCode: 500, body: { error: 'corrupt blob', detail: String(e.message || e) } } }];\n}\n\nreturn [{ json: {\n  statusCode: 200,\n  body: {\n    data_id: prev.data_id,\n    room_id: prev.room_id,\n    uri: `eo-blob://${prev.data_id}`,\n    envelope,\n  }\n}}];"
      },
