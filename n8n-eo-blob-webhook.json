    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nif (resp.statusCode === 403 || resp.statusCode === 404) {\n  return [{ json: { __error: true, statusCode: 403, errorBody: { error: 'forbidden: not a member of this room' } } }];\n}\nif (resp.statusCode !== 200) {\n  return [{ json: { __error: true, statusCode: 502, errorBody: { error: 'membership check failed', detail: resp.statusCode } } }];\n}\nif (resp.body?.membership !== 'join') {\n  return [{ json: { __error: true, statusCode: 403, errorBody: { error: `forbidden: membership=${resp.body?.membership || 'unknown'}` } } }];\n}\nconst prev = $('Check whoami').first().json;\nreturn [{ json: {\n  __error: false,\n  user_id: prev.user_id,\n  op: prev.op,\n  room_id: prev.room_id,\n  data_id: prev.data_id,\n  envelope: prev.envelope,\n  file_path: prev.file_path,\n}}];"
      },
