    {
      "parameters": {
        "jsCode": "// Prepare envelope for write — convert to binary for the file node.\n// Pull from Authorize1 explicitly so upstream pass-through nodes (e.g.\n// Store: ensure dir) can be inserted without breaking this node's data.\nconst d = $('Authorize1').first().json;\nreturn [{\n  json: { file_path: d.file_path, data_id: d.data_id, room_id: d.room_id },\n  binary: {\n    data: {\n      data: Buffer.from(JSON.stringify(d.envelope)).toString('base64'),\n      mimeType: 'application/json',\n      fileName: `${d.data_id}.enc`,\n    }\n  }\n}];"
      },
      "id": "c79ea39f-c14f-42af-a3c8-325dffb4b8f3",
