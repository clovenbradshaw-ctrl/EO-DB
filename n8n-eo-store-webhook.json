    {
      "parameters": {
        "jsCode": "const body = $('Webhook1').first().json.body;\nconst headers = $('Webhook1').first().json.headers || {};\n\nconst driveUrl = body.drive_url;\nconst driveMethod = (body.drive_method || 'GET').toUpperCase();\nconst driveBody = body.drive_body || null;\n\n// Forward Range header if present (for partial log downloads)\nconst rangeHeader = headers['range'] || headers['Range'] || null;\n\nif (!driveUrl || !driveUrl.startsWith('https://www.googleapis.com/')) {\n  throw new Error('Invalid or missing drive_url');\n}\n\n// Detect if this is a binary file download (alt=media in URL)\nconst isBinaryDownload = driveUrl.includes('alt=media');\n\nreturn [{ json: { driveUrl, driveMethod, driveBody, rangeHeader, isBinaryDownload } }];"
      },
