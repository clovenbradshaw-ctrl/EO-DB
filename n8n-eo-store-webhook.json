      "typeVersion": 1.1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "jsCode": "// Store the encrypted envelope keyed by content_hash.\n// n8n's built-in static data acts as a simple KV store.\n// For production, swap this with S3, Postgres, etc.\nconst body = $('POST Webhook').first().json.body;\nconst envelope = body.envelope;\nconst dataId = body.data_id;\nconst hash = envelope.content_hash;\n\n// Use workflow static data as KV store\nconst store = $getWorkflowStaticData('global');\nif (!store.blobs) store.blobs = {};\nstore.blobs[hash] = { envelope, data_id: dataId, stored_at: new Date().toISOString() };\n\nreturn [{ json: { ok: true, content_hash: hash } }];"
      },
      "id": "node-store",
      "name": "Store Blob",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, -300]
    },
