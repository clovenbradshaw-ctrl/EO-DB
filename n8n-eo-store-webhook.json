      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": { "responseCode": 200 }
      },
      "id": "node-post-ok",
      "name": "POST Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, -300]
    },
    {
      "parameters": {
        "jsCode": "// Retrieve an encrypted envelope by content_hash.\nconst query = $('GET Webhook').first().json.query;\nconst hash = query.hash;\n\nconst store = $getWorkflowStaticData('global');\nconst blobs = store.blobs || {};\nconst entry = blobs[hash];\n\nif (entry) {\n  return [{ json: { ok: true, envelope: entry.envelope } }];\n} else {\n  return [{ json: { ok: false, error: 'not_found' } }];\n}"
      },
      "id": "node-retrieve",
