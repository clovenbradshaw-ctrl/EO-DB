        "jsCode": "const body = $('Webhook1').first().json.body;\nconst dataType = body.data_type || 'default';\nconst hash = body.envelope.content_hash;\nconst dataId = body.data_id;\n\nreturn [{\n  json: {\n    fileName: `${hash}.json`,\n    folderName: dataType,\n    fileContent: JSON.stringify({\n      envelope: body.envelope,\n      data_id: dataId,\n      data_type: dataType,\n      stored_at: new Date().toISOString()\n    }),\n    content_hash: hash\n  }\n}];"
