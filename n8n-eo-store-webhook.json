    {
      "parameters": {
        "jsCode": "// Matrix room membership check.\n// Clients include space_room_id in the request body to identify which space they are\n// accessing. We verify the authenticated user is a member of that room by calling\n// /_matrix/client/v3/rooms/{roomId}/joined_members with their own token.\n// Matrix only returns 200 for this endpoint if the requesting user is in the room.\n// Any non-200 response (typically 403) means they are not a member.\n//\n// If space_room_id is absent (legacy clients), the check is skipped and the request\n// proceeds — encryption still prevents access to restricted data.\n\nconst body = $('Webhook1').first().json.body;\nconst matrixToken = body.matrix_token;\nconst spaceRoomId = body.space_room_id;\n\nif (!spaceRoomId) {\n  // Legacy request without a room ID — skip membership check.\n  return [{ json: { membershipOk: true } }];\n}\n\ntry {\n  const response = await this.helpers.httpRequest({\n    url: `https://app.aminoimmigration.com/_matrix/client/v3/rooms/${encodeURIComponent(spaceRoomId)}/joined_members`,\n    method: 'GET',\n    headers: {\n      Authorization: 'Bearer ' + matrixToken,\n    },\n    returnFullResponse: true,\n    ignoreHttpStatusErrors: true,\n  });\n\n  // Matrix returns 200 only when the requesting user is already a room member.\n  const isMember = response.statusCode === 200;\n  return [{ json: { membershipOk: isMember } }];\n} catch {\n  // Network error or unexpected failure — treat as not a member.\n  return [{ json: { membershipOk: false } }];\n}\n"
      },
