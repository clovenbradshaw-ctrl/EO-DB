    {
      "parameters": {
        "jsCode": "// Two request modes:\n//   1. JSON: legacy {matrix_token, drive_url, drive_method, drive_body?, space_room_id?}\n//   2. Binary upload: Content-Type: application/octet-stream, raw ciphertext as body,\n//      metadata in X-Eo-* headers. We re-wrap the bytes server-side into the JSON\n//      envelope Drive consumers expect, so the file format on Drive is unchanged.\n//\n// Binary mode lets the browser send compressed ciphertext without the +33% base64\n// JSON overhead, keeping uploads under nginx's client_max_body_size.\n\nconst wh = $('Webhook1').first().json;\nconst body = wh.body || {};\nconst headers = wh.headers || {};\nconst contentType = (headers['content-type'] || '').toLowerCase();\nconst isBinaryUpload = contentType.startsWith('application/octet-stream');\n\nconst rangeHeader = headers['range'] || headers['Range'] || null;\n\nlet driveUrl;\nlet driveMethod;\nlet driveBody;\nlet isBinaryDownload;\n\nif (isBinaryUpload) {\n  driveUrl = headers['x-eo-drive-url'];\n  driveMethod = (headers['x-eo-drive-method'] || 'PATCH').toUpperCase();\n\n  // n8n with rawBody:true exposes the body buffer under wh.body. When the\n  // content-type is binary, n8n keeps it as a Buffer; convert to base64 for\n  // the JSON envelope ct field. (If your n8n version exposes binary under\n  // wh.binary.data, swap accordingly.)\n  let ctB64;\n  if (Buffer.isBuffer(wh.body)) {\n    ctB64 = wh.body.toString('base64');\n  } else if (typeof wh.body === 'string') {\n    ctB64 = wh.body; // already base64 (n8n decodes binary into base64 when configured)\n  } else if (wh.body && wh.body.type === 'Buffer' && Array.isArray(wh.body.data)) {\n    ctB64 = Buffer.from(wh.body.data).toString('base64');\n  } else {\n    throw new Error('Binary upload body missing or unrecognised shape');\n  }\n\n  driveBody = {\n    v: parseInt(headers['x-eo-envelope-version'] || '2', 10),\n    iv: headers['x-eo-iv'],\n    ct: ctB64,\n    content_hash: headers['x-eo-content-hash'],\n    key_id: headers['x-eo-key-id'],\n    plaintext_size: parseInt(headers['x-eo-plaintext-size'] || '0', 10),\n    compression: headers['x-eo-compression'] || 'none',\n  };\n  isBinaryDownload = false;\n} else {\n  driveUrl = body.drive_url;\n  driveMethod = (body.drive_method || 'GET').toUpperCase();\n  driveBody = body.drive_body || null;\n  isBinaryDownload = !!(driveUrl && driveUrl.includes('alt=media'));\n}\n\nif (!driveUrl || !driveUrl.startsWith('https://www.googleapis.com/')) {\n  throw new Error('Invalid or missing drive_url');\n}\n\nreturn [{ json: { driveUrl, driveMethod, driveBody, rangeHeader, isBinaryDownload } }];"
      },
