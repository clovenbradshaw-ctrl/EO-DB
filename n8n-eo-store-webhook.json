        "jsCode": "const files = $json.files || [];\nconst dataType = $('Prep List').first().json.dataType;\nconst entries = files.map(f => {\n  const name = f.name || '';\n  const hash = name.replace('.json', '');\n  return {\n    data_id: f.id,\n    content_hash: hash,\n    data_type: dataType || ((f.parents && f.parents[0]) || 'unknown'),\n    stored_at: f.createdTime || ''\n  };\n});\nreturn [{ json: { ok: true, entries } }];"
