        "jsCode": "// Build response for binary downloads\n// Pass through statusCode and Content-Range header if present\nconst item = $input.first();\nconst statusCode = item.json.statusCode || 200;\nconst contentRange = item.json.headers?.['content-range'] || null;\nconst contentLength = item.json.headers?.['content-length'] || null;\n\nreturn [{\n  json: {\n    statusCode,\n    contentRange,\n    contentLength,\n    isBinary: true\n  },\n  binary: item.binary\n}];"
