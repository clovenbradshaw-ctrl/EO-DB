    {
      "parameters": {
        "jsCode": "const body = $('Webhook1').first().json.body;\nconst driveUrl = body.drive_url;\nconst driveMethod = (body.drive_method || 'GET').toUpperCase();\nconst driveBody = body.drive_body || null;\n\nif (!driveUrl || !driveUrl.startsWith('https://www.googleapis.com/')) {\n  throw new Error('Invalid or missing drive_url');\n}\n\nreturn [{ json: { driveUrl, driveMethod, driveBody } }];"
      },
